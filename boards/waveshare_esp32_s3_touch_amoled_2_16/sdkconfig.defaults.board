# Board-specific sdkconfig defaults for the Waveshare ESP32-S3-Touch-AMOLED-2.16
# (ESP32-S3R8: 16 MB QIO flash, 8 MB octal PSRAM @ 80 MHz -- see
# docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md). `idf.py bmgr -b waveshare_esp32_s3_touch_amoled_2_16`
# merges this file into components/gen_bmgr_codes/board_manager.defaults, which
# takes priority over firmware/sdkconfig.defaults. Like every sdkconfig
# defaults file it only applies when firmware/sdkconfig does not exist yet:
# delete firmware/sdkconfig after changing it.

# Flash: QIO, 80 MHz, 16 MB.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# This board's partition table (layout rules: docs/porting-guide.md). ESP-IDF
# resolves a relative filename against the project directory (firmware/).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../boards/waveshare_esp32_s3_touch_amoled_2_16/partitions.csv"

# External octal PSRAM, 80 MHz, usable via malloc() (os::alloc(Mem::Large) --
# see components/wisp_port_esp/os/os_esp.cpp).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Run code and read-only data from PSRAM instead of flash: the bootloader
# copies them there at boot. The 80 MHz octal PSRAM refills the 16 KB
# instruction cache faster than the 80 MHz quad flash, and LVGL's render
# loop misses that cache a lot: scrolling the self-check list goes from 14
# to 20 fps (docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md, "性能基准"). Costs
# about as much PSRAM as the image (~3 MB) and almost no internal RAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# With XIP, ESP-IDF no longer disables the cache while it erases or writes
# flash, so a cache miss on a runtime flash mapping during that time reads
# 0xFF instead of the data. Runtime mappings here are the vector-font
# partition (read on every uncached glyph; garbage there crashed the UI
# task during OTA) and the images ESP-IDF maps itself: the new app that
# esp_ota_end() verifies and otadata. Auto-suspend pauses the erase or
# write for those reads. It depends on the flash chip: this board's XMC
# 0x204018 advertises suspend in SFDP and ESP-IDF enables it ("Flash
# suspend feature is enabled" at boot). A flash ESP-IDF does not accept
# fails an assert at boot. Measurements and the check for another flash:
# docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md, docs/porting-guide.md.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y

# Console over USB-Serial-JTAG (no external UART-to-USB bridge on this
# board -- see docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
