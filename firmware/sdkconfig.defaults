# Wisp firmware defaults shared by every board: board-independent settings
# only. Flash size/mode, PSRAM, console and the partition table belong to the
# board and live in boards/<board>/sdkconfig.defaults.board (merged in by
# `idf.py bmgr`). Committed (unlike sdkconfig/sdkconfig.old, which idf.py
# generates and which are gitignored); idf.py regenerates the real sdkconfig
# from these files plus Kconfig defaults only when sdkconfig does not exist.

# CPU frequency.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Instruction cache 32 KB (ESP-IDF default 16 KB). Code runs from flash (no
# board enables XIP from PSRAM), so every miss is a QSPI flash read, and one
# frame's rendering code is far larger than the cache. Measured on both
# reference boards: the diagnostics scroll went from about 12.5 to 22 fps,
# for 16 KB of internal RAM (docs/hardware/*.md).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# LVGL must use wisp_ui's own lv_conf.h (see firmware/CMakeLists.txt's
# LV_CONF_PATH wiring and AGENTS.md's "LVGL configuration" pitfall), not LVGL's
# Kconfig-generated one.
CONFIG_LV_CONF_SKIP=n

# The lvgl/lvgl IDF component (env_support/cmake/kconfig.cmake) builds its
# own examples/demos tree by default (CONFIG_LV_BUILD_EXAMPLES/_DEMOS
# default y) -- those reference fonts and features wisp_ui's lv_conf.h
# doesn't enable (e.g. lv_font_montserrat_14) and aren't needed anyway.
# Mirrors cmake/wisp_host_deps.cmake's CONFIG_LV_BUILD_DEMOS/EXAMPLES/
# THORVG_INTERNAL OFF for the host build.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_THORVG_INTERNAL=n

# C++20, no exceptions/RTTI (AGENTS.md section 5).
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# wisp::app::App's main-thread work (board/device bring-up, EventBus,
# StorageManager, ButtonService, UiRuntime start) all currently runs
# inline from app_main(), on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FreeRTOS's default 100 Hz tick (10 ms/tick) is too coarse for LVGL/UI
# timing. At 1000 Hz the granularity is 1 ms. os_esp.cpp's ms_to_ticks()
# rounds up to whole ticks, but vTaskDelay(n) itself may still wait up to
# one tick less than requested (the actual wait is in (n-1, n] ticks).
CONFIG_FREERTOS_HZ=1000

# Lets the tasks that never touch flash keep their stacks in PSRAM
# (os::TaskConfig::flash_access, AGENTS.md section 5). Already the
# default on the S3; pinned so that a change in menuconfig shows up here.
# The option exists only with PSRAM. An ESP32 board turns it off in its
# own sdkconfig.defaults.board (ESP-IDF's help: stacks in PSRAM are unsafe
# there); the port then falls back to internal stacks.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Every wisp::os::Timer shares the one esp_timer dispatch task (see
# os_esp.cpp's Timer section); the default stack is sized for ESP-IDF's
# own light callbacks. Raised with headroom for wisp Timer callbacks.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144

# Release build (connectivity spec 3.2): this file is the release
# configuration; firmware/sdkconfig.debug layers a debug build on top.
# Optimized for size, except the rendering path (LVGL, wisp_ui, the
# display/touch drivers and the LCD flush path), which pins -O2 in its own
# component (see docs/porting-guide.md). Assertions stay compiled but
# silent: a failed one aborts without the file/line strings.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# esp_log keeps its default runtime level (Info). wisp::log is the only
# filter for wisp output: EspLogSink (log_esp.cpp) writes directly to the
# console and bypasses esp_log's per-tag filtering. Nothing above Info is
# compiled in; the debug build raises the maximum to Debug.
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Firmware upload (connectivity spec 6.5): the bootloader boots a freshly
# installed image in a pending state and returns to the previous one if it
# resets before App::start() has marked it valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Boot time: the PSRAM test reads and writes all of it on every boot
# (420 ms with 8 MB); a wake from deep sleep skips the bootloader's
# check of the app image (about 400 ms), which already passed on the boot
# that went to sleep.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# Power management (spec 6.7): PM_ENABLE compiles in DFS/light
# -sleep support; firmware/main/main.cpp's apply_pm_config() keeps DFS
# (240<->80 MHz) always on via esp_pm_configure() and only toggles
# light_sleep_enable there, at runtime, as PowerManager enters/exits
# standby. FREERTOS_USE_TICKLESS_IDLE is the kernel-side half of
# automatic light sleep that light_sleep_enable actually switches.
# USJ_NO_AUTO_LS_ON_CONNECTION keeps a connected USB-Serial-JTAG debug
# session from being cut off by light sleep (it acquires an
# ESP_PM_NO_LIGHT_SLEEP lock for as long as the port is connected) without
# this firmware needing to detect that itself -- see
# docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md for why this is needed at all on
# this chip/IDF version, and for the manual verification steps.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Networking (connectivity spec 2.1, 3.1, 10). Wi-Fi and lwIP buffers go to
# PSRAM where the driver allows it, so the radio does not squeeze LVGL and
# the other tasks out of internal RAM (only takes effect on boards with
# PSRAM). The default event loop task runs EspWifi's event handlers, which
# log; 4 KiB leaves room for the log path.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# The radio's static RX/TX buffers stay in internal DMA RAM (about 1.7 KB
# each) whatever the line above says. With PSRAM, IDF defaults to 16 + 16
# (54 KB); 10 + 10 keeps 20 KB of internal RAM for the httpd stacks and TLS
# (AGENTS.md section 5). Traffic here is TCP with a 4-segment window
# (CONFIG_LWIP_TCP_WND_DEFAULT 5760), so more than ~10 frames are rarely in flight.
# The RX block-ack window must not exceed the static RX buffers. IDF
# recommends 16 with PSRAM for throughput and for compatibility with some
# access points; 10 has only been tried against a PC's hotspot, so a
# router that stalls or reassociates is the thing to watch
# (docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md, checklist item 44).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
# mDNS's packets and records likewise.
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# WPA2/WPA3-Enterprise (802.1X) is not offered: WifiService only stores a
# passphrase per network.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set

# HTTPS for the LLM connectivity test: verify servers against the IDF
# certificate bundle (wisp::port::esp::EspHttpClient). The full bundle,
# not the "common" subset: that one lacks roots that LLM endpoints and
# gateways chain to (SSL.com, used by Cloudflare's edge certificates;
# TrustAsia), and a user-chosen base URL can be anywhere.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Every mbedTLS allocation goes to PSRAM. Through plain malloc() only the
# 16 KiB incoming record buffer did (it is above
# CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL); the 4 KiB outgoing buffer, the SSL
# context, the handshake state, the parsed peer chain and the bignum
# temporaries, all smaller, took an estimated 15-20 KB of internal RAM during a
# handshake, and two TLS sessions can overlap (the gate serialises only
# handshakes). That put the worst case below the internal-RAM floor
# (wisp/app/ram_budget.hpp; docs/hardware/waveshare_esp32_s3_touch_amoled_2_16.md).
# The crypto accelerators' DMA copies PSRAM operands through internal
# bounce buffers itself. Costs: a slower handshake (bignum work on PSRAM),
# and keys, the request with its Authorization header and the response sit
# in PSRAM, unencrypted there unless flash encryption is on -- as the LLM
# request and reply bodies already do (AGENTS.md section 5). The Wi-Fi
# supplicant's crypto (CONFIG_ESP_WIFI_MBEDTLS_CRYPTO) allocates the same
# way. CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE stays off (the IDF
# default); dynamic record buffers (CONFIG_MBEDTLS_DYNAMIC_BUFFER) would
# now only save PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Admin server (wisp::port::esp::EspHttpServer): the /api/v1/ws WebSocket,
# with the pre-handshake hook that lets an unauthorized upgrade be refused
# with a plain 403 before the 101. The header limit caps a request's whole
# header block (anything longer is a 431); httpd allocates only what a
# request actually uses, so the limit costs nothing until it is reached.
# A browser request with the session cookie and If-None-Match is about
# 600 bytes; 2048 leaves room for extra cookies set by other services on
# the same host name.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# Sockets: the admin httpd (7 clients + 3 of its own), the hotspot's
# port-80 httpd (4 + 3), the captive DNS responder (1), the LLM test's
# client (1), the scene HTTP proxy's client (1, one request at a time)
# and the network time query (1, one at a time) make 21; the rest is
# headroom. mDNS uses raw lwIP, no socket.
CONFIG_LWIP_MAX_SOCKETS=24
